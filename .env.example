# Desenvolvimento e producao usam PostgreSQL. No Neon, prefira o endpoint pooled (-pooler)
# para a aplicacao e mantenha a URL direta somente para migrations/importacao.
APP_ENV=development
DATABASE_URL=postgresql://usuario:senha@ep-exemplo-pooler.regiao.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:senha@ep-exemplo.regiao.aws.neon.tech/neondb?sslmode=require

# A suite automatizada define APP_ENV=test e usa exclusivamente TEST_DATABASE_URL.
# Nunca aponte esta variavel para o banco de producao.
TEST_DATABASE_URL=sqlite+pysqlite:///storage/test_database.db

# Duracao da sessao autenticada. Padrao: 168 horas (7 dias).
SESSION_TTL_HOURS=168

# Origens adicionais do frontend, separadas por virgula. Em producao integrada
# na Vercel, frontend e API usam a mesma origem e esta variavel pode ficar vazia.
CORS_ORIGINS=

# URL publica usada nos links enviados por e-mail. Em producao, use o dominio
# publico da aplicacao, sem barra final.
APP_PUBLIC_URL=https://exemplo.vercel.app

# Entrega de verificacao de e-mail e recuperacao de senha. Nunca use o prefixo
# VITE_ nestas variaveis: elas pertencem exclusivamente ao backend.
# Use memory localmente. Na Vercel, defina explicitamente como resend.
EMAIL_PROVIDER=memory
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Nivra <conta@seu-dominio-verificado.com>

# Open Finance Sandbox (Pluggy). Estas variaveis pertencem somente ao backend.
# Nunca use o prefixo VITE_ nem exponha estes valores no frontend.
PLUGGY_CLIENT_ID=seu_client_id_sandbox
PLUGGY_CLIENT_SECRET=seu_client_secret_sandbox
OPEN_FINANCE_ENVIRONMENT=sandbox
